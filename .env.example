LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
FREE_CREDITS=100
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.vercel.app
WORKER_CONCURRENCY=1

# Firecrawl trial mode protection (shared rate limiter across all workers)
FIRECRAWL_TRIAL=true
FIRECRAWL_TRIAL_RPM=10

# For paid Firecrawl plans, set FIRECRAWL_TRIAL=false and configure:
# FIRECRAWL_RPM=1000
# FIRECRAWL_CONCURRENT=50